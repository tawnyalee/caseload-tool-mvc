__pycache__/
*.pyc
.vs/
.vs/
logs/

# Local per-install data (groups/actions/templates a user creates in-app) -
# not meant to be shipped or shared via git; each install starts empty.
data/templates.json
src/data/actions.json
src/data/groups.json
src/data/saved_batches.json

# Old saved Salesforce session file - no longer created (the login now
# lives in memory only), kept ignored in case an old copy is ever restored.
data/.salesforce_session.json

# Old saved Mongoose session file - no longer created (in memory only now,
# same as Salesforce), kept ignored in case an old copy is ever restored.
data/.mongoose_session.json

# Persisted StudentID -> Mongoose Contact Id map - derived, per-install data.
src/data/mongoose_contact_ids.json

# Test mode switch (see src/services/test_mode.py) - per machine, holds a
# personal email address. Never commit.
data/test_mode.json
